# --- Mode ---------------------------------------------------------------
# Live trading needs BOTH POLYMARKET_DRY_RUN=false and LIVE_TRADING=true.
# Anything else runs in dry-run (paper) mode.
POLYMARKET_DRY_RUN=true
LIVE_TRADING=false
KILL_SWITCH=false
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
# 0 = EOA wallet, 1 = email/Magic proxy wallet, 2 = browser-wallet proxy (Gnosis Safe)
POLYMARKET_SIGNATURE_TYPE=1

# --- Sizing & entry -----------------------------------------------------
# Stake per trade is min(TRADE_USDC, MAX_POSITION_SIZE).
TRADE_USDC=5
MAX_POSITION_SIZE=25
# Model probability minus best ask.
MIN_EDGE=0.07
# Model probability minus average fill for the full stake minus EXECUTION_COST.
MIN_EDGE_AFTER_COSTS=0.08
# Per-share buffer for taker fees and slippage (these markets charge taker fees).
EXECUTION_COST=0.02
MAX_BUY_PRICE=0.92
MAX_SPREAD=0.08
MIN_SECONDS_LEFT=8
MAX_SECONDS_LEFT=45
MIN_MARKET_VOLUME=1000
MIN_LIQUIDITY=1000
MIN_PRICE_HISTORY_SECONDS=60

# --- Risk limits (reset at 00:00 UTC; also reset on restart) --------------
MAX_TRADES_PER_DAY=20
MAX_TRADES_PER_HOUR=10
MAX_DAILY_LOSS=50
MAX_OPEN_POSITIONS=2
MAX_CONSECUTIVE_LOSSES=3

# --- Runtime --------------------------------------------------------------
POLL_SECONDS=2
MARKET_REFRESH_SECONDS=30
TRADE_LOG_PATH=trade_log.jsonl
LOG_LEVEL=INFO

# --- BTC price feeds --------------------------------------------------------
# Coinbase BTC-USD is preferred when enabled; Binance is geo-blocked in the US.
ENABLE_COINBASE_FEED=false
ENABLE_OKX_FALLBACK=false
ENABLE_BINANCE_FALLBACK=true
BTC_SYMBOL=btcusdt
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public
PRICE_MAX_AGE_SECONDS=10
PRICE_MAX_DIVERGENCE_BPS=50
COINBASE_STALE_AFTER_SECONDS=10
PRICE_RECONNECT_MIN_SECONDS=1
PRICE_RECONNECT_MAX_SECONDS=30
PRICE_SILENCE_RECONNECT_SECONDS=30

GAMMA_URL=https://gamma-api.polymarket.com
CLOB_URL=https://clob.polymarket.com
